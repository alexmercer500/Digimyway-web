---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { site, legalLinks } from '@/config/site';

interface Props {
  title: string;
  eyebrow: string;
  subtitle?: string;
}

const { title, eyebrow, subtitle } = Astro.props;
const others = legalLinks.filter((link) => !link.href.includes(Astro.url.pathname));
---

<BaseLayout title={title} description={`${title} for ${site.name}.`}>
  <PageHero eyebrow={eyebrow} title={title} subtitle={subtitle} />

  <section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <p class="mb-8 text-sm text-ink-500">
      {site.legal.entity} · Last updated {site.legalUpdated}
    </p>

    <article class="legal-prose">
      <slot />
    </article>

    <div class="mt-14 rounded-2xl border border-ink-100 bg-ink-50 p-6">
      <h2 class="font-display text-base font-bold text-ink-900">Questions about this policy?</h2>
      <p class="mt-1 text-sm text-ink-600">
        Write to
        <a class="font-medium text-brand-700 underline" href={`mailto:${site.contact.email}`}>
          {site.contact.email}
        </a>
        or visit our <a class="font-medium text-brand-700 underline" href="/contact">contact page</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          others.map((link) => (
            <a
              href={link.href}
              class="rounded-lg border border-ink-200 bg-white px-3 py-1.5 text-sm font-medium text-ink-700 transition-colors hover:border-brand-300 hover:text-brand-700"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
