---
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import Seo from '@/components/Seo.astro';
import DevBanner from '@/components/DevBanner.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <Seo title={title} description={description} canonical={canonical} noindex={noindex} />
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <DevBanner />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
