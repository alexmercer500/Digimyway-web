---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="font-display text-6xl font-extrabold text-brand-500">404</p>
    <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight">Page not found</h1>
    <p class="mt-3 max-w-md text-lg text-ink-600">
      Sorry, we couldn't find the page you were looking for. It may have been moved or removed.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-6 py-3.5 text-base font-semibold text-ink-950 transition-colors hover:bg-brand-400"
      >
        <Icon name="arrow" class="h-5 w-5 rotate-180" />
        Back to home
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-ink-200 bg-white px-6 py-3.5 text-base font-semibold text-ink-800 transition-colors hover:bg-ink-50"
      >
        Contact support
      </a>
    </div>
  </section>
</BaseLayout>
