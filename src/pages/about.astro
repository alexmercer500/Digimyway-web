---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';

const values = [
  {
    icon: 'shield',
    title: 'Trust first',
    body: 'Every technician on the network is verified and every payment is protected. Trust is the product, not a feature.',
  },
  {
    icon: 'card',
    title: 'Radical transparency',
    body: 'Real quotes, real part grades, real prices. No hidden markups and no surprises at the counter.',
  },
  {
    icon: 'users',
    title: 'Empowering local businesses',
    body: 'We help neighbourhood repair shops reach nearby customers, bid fairly and grow on their own terms.',
  },
  {
    icon: 'spark',
    title: 'Built for everyone',
    body: 'Simple, low-friction experiences that work for first-time smartphone users and power users alike.',
  },
];

const milestones = [
  { stat: '10 km', label: 'Verified technician search radius' },
  { stat: '3', label: 'Part grades for every repair' },
  { stat: '6 months', label: 'Escrow-backed warranty window' },
  { stat: '4', label: 'Steps from request to payment' },
];
---

<BaseLayout
  title="About us"
  description={`Learn about ${site.name}, our mission and the team making device repair transparent, fair and trustworthy.`}
>
  <PageHero
    eyebrow="About us"
    title={`Making device repair transparent, fair and dependable`}
    subtitle={`${site.name} is a ${site.legal.entity} product that connects people with verified, nearby repair technicians — and lets those technicians compete fairly for their business.`}
  />

  <!-- Story -->
  <section class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl">Our story</h2>
        <div class="legal-prose mt-4 max-w-none">
          <p>
            Getting a phone or tablet repaired is one of the most common — and least transparent —
            transactions people make. Prices vary wildly between shops, part quality is impossible to
            judge, and there is little recourse if a repair fails. Customers are left to walk from
            counter to counter, haggling blind.
          </p>
          <p>
            {site.name} was built to change that. We turn a single repair request into a live,
            competitive market: describe the fault once, and verified technicians nearby respond with
            clear, tiered quotes. Customers compare them side by side and choose the price, the part
            grade and the turnaround that works for them. Payment is held securely and released only
            after the repair is inspected and confirmed.
          </p>
          <p>
            For technicians, the platform means a steady stream of nearby, relevant jobs, a level
            playing field to bid on, and tools to manage orders, pricing and settlements — so local
            repair businesses can compete on quality instead of marketing budgets.
          </p>
        </div>
      </div>

      <aside class="rounded-2xl border border-ink-100 bg-ink-50 p-6">
        <h3 class="font-display text-base font-bold">Company details</h3>
        <dl class="mt-4 flex flex-col gap-3 text-sm">
          <div>
            <dt class="text-ink-500">Legal entity</dt>
            <dd class="font-medium text-ink-900">{site.legal.entity}</dd>
          </div>
          <div>
            <dt class="text-ink-500">Registered office</dt>
            <dd class="font-medium text-ink-900">
              {site.legal.address.line1}, {site.legal.address.locality},
              {site.legal.address.region} {site.legal.address.postalCode}, {site.legal.address.country}
            </dd>
          </div>
          <div>
            <dt class="text-ink-500">Email</dt>
            <dd class="font-medium text-ink-900">
              <a class="text-brand-700 underline" href={`mailto:${site.contact.email}`}>
                {site.contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-ink-500">Phone</dt>
            <dd class="font-medium text-ink-900">{site.contact.phone}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- Mission / What we do -->
  <section class="border-y border-ink-100 bg-ink-50">
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl">What we do</h2>
          <div class="legal-prose mt-4 max-w-none">
            <p>
              {site.name} is a device-repair marketplace. We connect customers who need a repair with
              a network of verified local technicians, and we handle the parts of the transaction that
              are usually risky: pricing, payments, warranty and dispute resolution.
            </p>
            <ul>
              <li>Live, competitive bidding from verified technicians nearby.</li>
              <li>Transparent multi-tier quotes — Original, OEM and Compatible parts.</li>
              <li>Escrow-protected payments released only after you confirm the repair.</li>
              <li>Real-time repair tracking and in-app customer support.</li>
              <li>Warranty issued against the exact part that was fitted.</li>
            </ul>
          </div>
        </div>
        <div>
          <h2 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl">Our mission</h2>
          <p class="mt-4 text-lg italic leading-relaxed text-ink-600">
            “To make device repair transparent, fair and dependable for every customer — and to help
            local repair businesses thrive on quality, not guesswork.”
          </p>
          <div class="mt-6 grid grid-cols-2 gap-4">
            {
              milestones.map((item) => (
                <div class="rounded-xl border border-ink-100 bg-white p-4">
                  <p class="font-display text-xl font-extrabold text-brand-600">{item.stat}</p>
                  <p class="mt-1 text-xs text-ink-600">{item.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl">What we stand for</h2>
      <p class="mt-3 text-lg text-ink-600">The principles that shape every decision we make.</p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value) => (
          <div class="rounded-2xl border border-ink-100 bg-white p-6 shadow-[var(--shadow-soft)]">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={value.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 font-display text-lg font-bold">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{value.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto w-full max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-6 rounded-3xl border border-ink-100 bg-ink-50 px-8 py-10 sm:flex-row">
      <div>
        <h2 class="font-display text-2xl font-extrabold tracking-tight">Partner with us</h2>
        <p class="mt-2 text-ink-600">
          Are you a repair technician? Join the network and reach customers near you.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-ink-900 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-ink-800"
      >
        Get in touch
        <Icon name="arrow" class="h-5 w-5" />
      </a>
    </div>
  </section>
</BaseLayout>
