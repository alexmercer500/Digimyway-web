---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';

const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT as string | undefined;
// Post to the configured form handler when present, otherwise hand off to the
// visitor's mail client via a mailto: action.
const action = formEndpoint || `mailto:${site.contact.email}`;
const enctype = formEndpoint ? 'application/x-www-form-urlencoded' : 'text/plain';

const channels = [
  {
    icon: 'chat',
    label: 'WhatsApp',
    value: site.contact.whatsapp,
    detail: 'Message us on WhatsApp',
    href: `https://wa.me/${site.contact.whatsapp.replace(/[^0-9]/g, '')}`,
  },
  {
    icon: 'phone',
    label: 'Call support',
    value: site.contact.phone,
    detail: 'Call our support team',
    href: `tel:${site.contact.phone.replace(/\s+/g, '')}`,
  },
  {
    icon: 'mail',
    label: 'Email',
    value: site.contact.email,
    detail: 'Email our support team',
    href: `mailto:${site.contact.email}`,
  },
];
---

<BaseLayout
  title="Contact us"
  description={`Get in touch with ${site.name}. Reach our support team by email, phone or WhatsApp, or send us a message.`}
>
  <PageHero
    eyebrow="Contact us"
    title="We're here to help"
    subtitle="Questions about a repair, a quote, a payment or partnering with us? Reach out and our team will get back to you."
  />

  <section class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-5">
      <!-- Contact channels + business details -->
      <div class="lg:col-span-2">
        <div class="flex flex-col gap-4">
          {
            channels.map((channel) => (
              <a
                href={channel.href}
                class="flex items-start gap-4 rounded-2xl border border-ink-100 bg-white p-5 shadow-[var(--shadow-soft)] transition-colors hover:border-brand-300"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                  <Icon name={channel.icon} class="h-6 w-6" />
                </span>
                <span>
                  <span class="block text-sm font-semibold text-ink-900">{channel.label}</span>
                  <span class="block text-base font-medium text-brand-700">{channel.value}</span>
                  <span class="mt-0.5 block text-xs text-ink-500">{channel.detail}</span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="mt-6 rounded-2xl border border-ink-100 bg-ink-50 p-6">
          <h2 class="font-display text-base font-bold">Business details</h2>
          <dl class="mt-4 flex flex-col gap-3 text-sm">
            <div>
              <dt class="text-ink-500">Legal entity</dt>
              <dd class="font-medium text-ink-900">{site.legal.entity}</dd>
            </div>
            <div>
              <dt class="text-ink-500">Registered office</dt>
              <dd class="font-medium text-ink-900">
                {site.legal.address.line1}, {site.legal.address.locality},
                {site.legal.address.region} {site.legal.address.postalCode}, {site.legal.address.country}
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Contact form -->
      <div class="lg:col-span-3">
        <div class="rounded-3xl border border-ink-100 bg-white p-6 shadow-[var(--shadow-soft)] sm:p-8">
          <h2 class="font-display text-xl font-extrabold tracking-tight">Send us a message</h2>
          <p class="mt-2 text-sm text-ink-600">
            Fill in the form and our team will get back to you.
          </p>

          <form class="mt-6 grid gap-4 sm:grid-cols-2" method="post" action={action} enctype={enctype}>
            <label class="flex flex-col gap-1.5 sm:col-span-1">
              <span class="text-sm font-medium text-ink-700">Full name</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                placeholder="Your name"
                class="rounded-xl border border-ink-200 bg-white px-4 py-3 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
              />
            </label>

            <label class="flex flex-col gap-1.5 sm:col-span-1">
              <span class="text-sm font-medium text-ink-700">Phone number</span>
              <input
                type="tel"
                name="phone"
                autocomplete="tel"
                placeholder="+91 98765 43210"
                class="rounded-xl border border-ink-200 bg-white px-4 py-3 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
              />
            </label>

            <label class="flex flex-col gap-1.5 sm:col-span-2">
              <span class="text-sm font-medium text-ink-700">Email address</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="rounded-xl border border-ink-200 bg-white px-4 py-3 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
              />
            </label>

            <label class="flex flex-col gap-1.5 sm:col-span-2">
              <span class="text-sm font-medium text-ink-700">Subject</span>
              <select
                name="subject"
                class="rounded-xl border border-ink-200 bg-white px-4 py-3 text-sm text-ink-900 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
              >
                <option>General enquiry</option>
                <option>Repair or quote support</option>
                <option>Payments &amp; refunds</option>
                <option>Warranty or dispute</option>
                <option>Technician partnership</option>
                <option>Press &amp; media</option>
              </select>
            </label>

            <label class="flex flex-col gap-1.5 sm:col-span-2">
              <span class="text-sm font-medium text-ink-700">Message</span>
              <textarea
                name="message"
                required
                rows="5"
                placeholder="How can we help?"
                class="resize-y rounded-xl border border-ink-200 bg-white px-4 py-3 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
              ></textarea>
            </label>

            <div class="sm:col-span-2">
              <button
                type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-500 px-6 py-3.5 text-base font-semibold text-ink-950 transition-colors hover:bg-brand-400 sm:w-auto"
              >
                Send message
                <Icon name="arrow" class="h-5 w-5" />
              </button>
              <p class="mt-3 text-xs text-ink-500">
                By submitting this form you agree to our
                <a class="text-brand-700 underline" href="/privacy">Privacy Policy</a>.
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
