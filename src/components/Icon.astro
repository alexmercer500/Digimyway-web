  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  check: '<path d="m5 12 5 5L20 7"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  tool: '<path d="M15 4a5 5 0 0 0-4.9 6.3L4 16.4V20h3.6l6.1-6.1A5 5 0 0 0 20 9l-3-3-2 2-2-2 2-2Z"/>',
  truck:
    '<path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7.5" cy="17.2" r="1.8"/><circle cx="17.5" cy="17.2" r="1.8"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  refresh: '<path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 4v5h-5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  users:
    '<path d="M16 20v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1"/><circle cx="9" cy="8" r="3.5"/><path d="M22 20v-1a4 4 0 0 0-3-3.8"/>',
  device: '<rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M10.5 5.25h3"/>',
  spark: '<path d="m12 3 1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8L12 3Z"/>',
  card: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/>',
};

interface Props {
  name: keyof typeof ICONS | string;
  class?: string;
  size?: number;
}

const { name, class: className = 'h-5 w-5', size } = Astro.props;
const inner = ICONS[name] ?? ICONS.check;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  width={size}
  height={size}
  aria-hidden="true"
  set:html={inner}
/>
