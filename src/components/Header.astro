---
import { navLinks } from '@/config/site';
import Logo from '@/components/Logo.astro';

const path = Astro.url.pathname;

const isActive = (href: string) => {
  if (href.includes('#')) return false;
  return href === '/' ? path === '/' : path.startsWith(href);
};
---

<header class="sticky top-0 z-50 border-b border-ink-100 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <Logo />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'text-brand-700'
                : 'text-ink-600 hover:bg-ink-50 hover:text-ink-900',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contact"
        class="hidden rounded-xl bg-ink-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-ink-800 sm:inline-flex"
      >
        Get started
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-ink-200 text-ink-700 [&::-webkit-details-marker]:hidden"
          aria-label="Toggle menu"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
            />
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 w-56 overflow-hidden rounded-xl border border-ink-100 bg-white p-2 shadow-[var(--shadow-lift)]"
        >
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-50"
              >
                {link.label}
              </a>
            ))
          }
          <a
            href="/contact"
            class="mt-1 block rounded-lg bg-ink-900 px-3 py-2 text-center text-sm font-semibold text-white"
          >
            Get started
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
