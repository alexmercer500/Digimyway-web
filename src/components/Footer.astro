---
import { site, legalLinks } from '@/config/site';
import Logo from '@/components/Logo.astro';

const year = new Date().getFullYear();
const { address } = site.legal;

const columns = [
  {
    heading: 'Product',
    links: [
      { label: 'Home', href: '/' },
      { label: 'How it works', href: '/#how-it-works' },
      { label: 'Why DigiMyWay', href: '/#features' },
      { label: 'FAQs', href: '/#faq' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About us', href: '/about' },
      { label: 'Contact us', href: '/contact' },
    ],
  },
  {
    heading: 'Legal',
    links: [...legalLinks],
  },
];
---

<footer class="bg-canvas text-ink-300">
  <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <Logo variant="light" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-400">{site.description}</p>
        <p class="mt-4 text-sm text-ink-400">
          <a href={`mailto:${site.contact.email}`} class="font-medium text-brand-400 hover:text-brand-300">
            {site.contact.email}
          </a>
          <span class="mx-2 text-ink-600">·</span>
          <a href={`tel:${site.contact.phone.replace(/\s+/g, '')}`} class="hover:text-white">
            {site.contact.phone}
          </a>
        </p>
      </div>

      {
        columns.map((column) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-white">{column.heading}</h3>
            <ul class="mt-4 flex flex-col gap-2.5 text-sm">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-ink-400 transition-colors hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year} {site.legal.entity}. All rights reserved. {site.name} is a product of {site.legal.entity}.
      </p>
      <p class="sm:text-right">
        {address.line1}, {address.locality}, {address.region} {address.postalCode}, {address.country}
      </p>
    </div>
  </div>
</footer>
