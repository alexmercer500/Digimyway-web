# Canonical origin of the deployed site. Used for canonical tags, og:url and
# the sitemap. Falls back to https://www.digimyway.com when unset.
SITE_URL=https://www.digimyway.com

# Optional: where the "contact us" form posts (e.g. a Formspree / Basin endpoint).
# When empty the contact page falls back to mailto: and WhatsApp links.
PUBLIC_CONTACT_FORM_ENDPOINT=
